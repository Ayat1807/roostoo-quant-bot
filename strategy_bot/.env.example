# Copy this file to .env and fill in the TESTING key pair.
# Never commit .env. Never paste keys into chat.
ROOSTOO_API_KEY=your_testing_api_key_here
ROOSTOO_API_SECRET=your_testing_api_secret_here
# "testing" for this phase. "competition" also needs allow_competition: true in config.yaml.
ROOSTOO_KEY_LABEL=testing
