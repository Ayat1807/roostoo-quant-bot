# Copy this file to .env.competition (git-ignored) and fill in the COMPETITION key pair.
# Used only by config_competition.yaml / config_competition_tm10.yaml (env_file: .env.competition).
# Never commit .env.competition. Never paste keys into chat. Never make manual API calls with it.
ROOSTOO_API_KEY=your_competition_api_key_here
ROOSTOO_API_SECRET=your_competition_api_secret_here
ROOSTOO_KEY_LABEL=competition
